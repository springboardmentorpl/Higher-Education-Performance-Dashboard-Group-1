      <aliases enabled='yes' />
      <column datatype='real' name='[Academic Reputation]' role='measure' type='quantitative' />
      <column caption='Research Impact Category' datatype='string' name='[Calculation_0520111170871296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Research Impact Score] &lt; 25 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Research Impact Score] &lt; 50 THEN &quot;Moderate&quot;&#13;&#10;ELSEIF [Research Impact Score] &lt; 75 THEN &quot;High&quot;&#13;&#10;ELSE &quot;Excellent&quot;&#13;&#10;END' />
      </column>
      <column caption='Ranking Category' datatype='string' name='[Calculation_0711699978862592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Global Ranking Score] &gt;= 90 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [Global Ranking Score] &gt;= 75 THEN &quot;High&quot;&#13;&#10;ELSEIF [Global Ranking Score] &gt;= 50 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_0711699980165121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Students KPI' datatype='string' name='[Calculation_0846391297855489]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(SUM([Number of Students]))' />
      </column>
      <column caption='Other Student Percentage' datatype='real' default-format='p0.00%' name='[Calculation_0846391315587074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [International Students %]' />
      </column>
      <column caption='Donut Hole' datatype='integer' name='[Calculation_0846391320129539]' role='measure' type='quantitative'>
